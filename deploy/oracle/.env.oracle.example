# ─────────────────────────────────────────────────────────────
# Bayiinet — Oracle Cloud / Ubuntu üretim .env örneği
#
# Kullanım:
#   sudo cp deploy/oracle/.env.oracle.example /var/www/bayiinet/.env
#   sudo nano /var/www/bayiinet/.env          # aşağıdaki ... alanları doldurun
#   cd /var/www/bayiinet
#   sudo -u www-data php artisan key:generate
#   sudo -u www-data php artisan config:cache
#   sudo systemctl restart bayiinet-queue bayiinet-schedule php8.3-fpm
#
# ⚠ .env asla Git'e eklenmez (.gitignore) ve depo geçmişinde bulunmamalıdır.
# ─────────────────────────────────────────────────────────────

APP_NAME=Bayiinet
APP_ENV=production

# HTTPS kurduktan sonra: https://www.bayiinet.com
APP_URL=https://www.bayiinet.com
APP_DEBUG=false
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_TIMEZONE=Europe/Istanbul
APP_KEY=

# Loglar: systemd/journal ve storage/logs/laravel.log
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ── Veritabanı ───────────────────────────────────────────────
# Aynı sunucudaki MySQL/MariaDB:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bayiinet
DB_USERNAME=bayiinet
DB_PASSWORD=GUCLU_BIR_SIFRE

# Uzak (yönetilen) MySQL kullanıyorsanız:
# DB_HOST=10.0.0.2
# DB_SOCKET=            # boş bırakın

# ── Oturum / önbellek / kuyruk ───────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
# HTTPS YOKSA false yapın, aksi hâlde tarayıcı çerezi kaydetmez ve GİRİŞ YAPILAMAZ.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# ── İlk yönetici hesabı (ilk kurulumda kullanılır) ───────────
ADMIN_EMAIL=destek@bayiinet.com
ADMIN_PASSWORD=EN_AZ_8_KARAKTER_GUCLU_SIFRE

# ── Kuyruk davranışı ─────────────────────────────────────────
# Kendi sunucuda gerçek systemd işçisi çalıştığı için KAPALI bırakın.
# (Render gibi web konteynerinde ayrı worker yoksa true yapılabilir.)
QUEUE_INLINE_DRAIN=false

# ── Trendyol ─────────────────────────────────────────────────
TRENDYOL_BATCH_SIZE=40
TRENDYOL_FALLBACK_BRAND_ID=2613880
TRENDYOL_BATCH_WAIT=9
TRENDYOL_MAX_PAGES=100
TRENDYOL_RETRY_TIMES=3
TRENDYOL_RETRY_SLEEP=1500

# Fiyat motoru (masaüstü pricing_engine ile aynı formül)
TRENDYOL_COMMISSION_RATE=15
TRENDYOL_MIN_PROFIT=10
TRENDYOL_ROUND_TO=0.99
TRENDYOL_DELIVERY_TYPE=standart
TRENDYOL_DEFAULT_DESI=5

# ── Otomasyon ────────────────────────────────────────────────
AUTO_XML_SYNC=true
AUTO_TRENDYOL_SYNC=true
AUTOMATION_HEARTBEAT_DELAY=75

# ── E-posta (opsiyonel) ──────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="destek@bayiinet.com"
MAIL_FROM_NAME="${APP_NAME}"
