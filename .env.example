APP_NAME=Bayiinet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.bayiinet.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bayiinet
DB_USERNAME=bayiinet
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
# HTTPS YOKSA false yapın; aksi hâlde tarayıcı çerezi kaydetmez ve giriş yapılamaz.
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
# İşçi, işi 'retry_after' süresi dolmadan bitirmelidir; aksi hâlde aynı iş
# ikinci kez dağıtılır (çift gönderim). Job zaman aşımı en fazla 840 sn olduğu
# için 960 güvenli aralıktır. Worker --timeout değeri de bunun altında kalmalı.
DB_QUEUE_RETRY_AFTER=960

MAIL_MAILER=log
MAIL_FROM_ADDRESS="destek@bayiinet.com"
MAIL_FROM_NAME="${APP_NAME}"

# İlk yönetici hesabı (sadece ilk kurulumda kullanılır)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Kendi sunucuda (Oracle Cloud/Ubuntu) gerçek systemd kuyruk işçisi çalıştığı
# için KAPALI bırakılır. Yalnızca web konteynerinde ayrı worker yoksa true yapın
# (Render gibi ortamlar) — açıkken web isteği sonunda kuyruk tüketilir.
QUEUE_INLINE_DRAIN=false
QUEUE_INLINE_DRAIN_LOOPS=3

# Trendyol'dan ürün gönderirken kullanılan varsayılanlar
TRENDYOL_BATCH_SIZE=40
TRENDYOL_FALLBACK_BRAND_ID=2613880
TRENDYOL_BATCH_WAIT=9
TRENDYOL_MAX_PAGES=100
TRENDYOL_RETRY_TIMES=3
TRENDYOL_RETRY_SLEEP=1500

# Trendyol fiyat motoru (masaüstü pricing_engine ile aynı formül)
TRENDYOL_COMMISSION_RATE=15
TRENDYOL_MIN_PROFIT=10
TRENDYOL_ROUND_TO=0.99
TRENDYOL_DELIVERY_TYPE=standart
TRENDYOL_DEFAULT_DESI=5

# /health-detail teşhis uç noktası anahtarı. Boşsa uç nokta yalnızca sunucunun
# kendisinden erişilebilir (önerilen). Doldurursanız ?token=... ile çağırın.
HEALTH_DETAIL_TOKEN=

# Saatlik otomasyon (false yaparak kapatılabilir)
AUTO_XML_SYNC=true
AUTO_TRENDYOL_SYNC=true
AUTOMATION_HEARTBEAT_DELAY=75
